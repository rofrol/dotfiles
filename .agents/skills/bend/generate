#!/bin/sh
# generate <commit>: write this skill's SKILL.md from PITFALLS.md of
# https://github.com/rofrol/bend-pitfalls at that commit, the canonical
# source; edit pitfalls there, never here.
set -eu
[ $# -eq 1 ] || { echo "usage: generate <commit>" >&2; exit 2; }
here=$(cd "$(dirname "$0")" && pwd -P)
src=${BEND_PITFALLS:-$HOME/personal_projects/bend/bend-pitfalls}
git -C "$src" fetch -q origin
rev=$(git -C "$src" rev-parse --verify "$1^{commit}")
tmp=$(mktemp "$here/SKILL.md.XXXXXX")
{
  cat <<HEAD
---
name: bend
description: Pitfalls of the Bend 2 language and its compiler met in the user's Bend projects (definition order, affine variables, match, inference, termination, proof rewrites, the JavaScript and native lanes), each with the version it was seen in. Load it before writing or changing Bend code or proofs, in any repository that uses Bend; the repository's own notes add what is specific to it.
---

# Bend 2 pitfalls

Generated by \`generate\` (next to this file) from PITFALLS.md of
https://github.com/rofrol/bend-pitfalls at $rev. Add or change a
pitfall there, then regenerate; never edit this file. A Bend repository
imports its own pinned copy, so a clone of it stands alone. Read \`bend
guide\` first; each entry names the Bend version it was seen with.

HEAD
  git -C "$src" show "$rev:PITFALLS.md" | awk 'f || /^## / { f = 1; print }'
} > "$tmp"
mv "$tmp" "$here/SKILL.md"
echo "SKILL.md from $rev"
