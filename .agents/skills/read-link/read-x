#!/usr/bin/env bash
# Print an X/Twitter post (author, stats, text with expanded links, media, quoted post) as plain text.
# Uses the public FxTwitter API (api.fxtwitter.com), a third-party proxy: no login, no cookies.
# Usage: read-x <x.com or twitter.com status URL | status id>
set -euo pipefail
[ $# -eq 1 ] || { echo "usage: read-x <status URL or id>" >&2; exit 2; }
id=$(printf '%s\n' "$1" | sed -nE 's#.*/status(es)?/([0-9]+).*#\2#p; s#^([0-9]+)$#\1#p' | head -1)
[ -n "$id" ] || { echo "read-x: no status id in: $1" >&2; exit 2; }
json=$(curl -sSL --max-time 30 "https://api.fxtwitter.com/status/$id") \
  || { echo "read-x: FxTwitter request failed for $id" >&2; exit 1; }
printf '%s\n' "$json" | jq -e . >/dev/null 2>&1 \
  || { echo "read-x: FxTwitter returned no JSON for $id (wrong id, or the API changed)" >&2; exit 1; }
printf '%s\n' "$json" | jq -r '
  def post:
    "@\(.author.screen_name) (\(.author.name)), \(.created_at)",
    "\(.likes) likes, \(.retweets) reposts, \(.replies) replies, \(.views // "?") views, lang \(.lang)",
    (if .replying_to then "In reply to @\(.replying_to), status \(.replying_to_status)" else empty end),
    "",
    ([.raw_text.facets[]? | select(.type == "url") | {key: .original, value: .replacement}]) as $urls
      | reduce $urls[] as $u (.raw_text.text // .text; split($u.key) | join($u.value)),
    (.media.all // [] | if length > 0 then "", "Media:", (.[] | "- \(.type): \(.url)") else empty end);
  if .code != 200 then "read-x: FxTwitter returned \(.code): \(.message)\n" | halt_error(1)
  else (.tweet | post), (.tweet.quote // empty | "", "--- Quoted post ---", post)
  end'
