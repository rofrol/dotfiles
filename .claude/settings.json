{
  "model": "opus",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/romanfrolow/.claude/hooks/uncommitted-notes.sh' check",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/romanfrolow/.claude/hooks/uncommitted-notes.sh' record",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/romanfrolow/.claude/hooks/uncommitted-notes.sh' compare",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/romanfrolow/.claude/hooks/uncommitted-notes.sh' snapshot",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 -I \"$HOME/.local/share/agent-kit/current/hooks/search_reminder.py\" --format claude",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/delay-check.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/question-preview.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$HOME/.local/share/agent-kit/current/hooks/policy_context.py\" --format claude --part 1 --parts 5"
          },
          {
            "type": "command",
            "command": "python3 -I \"$HOME/.local/share/agent-kit/current/hooks/policy_context.py\" --format claude --part 2 --parts 5"
          },
          {
            "type": "command",
            "command": "python3 -I \"$HOME/.local/share/agent-kit/current/hooks/policy_context.py\" --format claude --part 3 --parts 5"
          },
          {
            "type": "command",
            "command": "python3 -I \"$HOME/.local/share/agent-kit/current/hooks/policy_context.py\" --format claude --part 4 --parts 5"
          },
          {
            "type": "command",
            "command": "python3 -I \"$HOME/.local/share/agent-kit/current/hooks/policy_context.py\" --format claude --part 5 --parts 5"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$HOME/.local/share/agent-kit/current/hooks/todo_reminder.py\" --format claude || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "jq -r '\"\\(.model.display_name) · \\(.workspace.current_dir | sub(env.HOME; \"~\"))\"'"
  },
  "enabledPlugins": {
    "shell-path-completion@local-mods": true,
    "typesafe@typesafe-ai": true
  },
  "extraKnownMarketplaces": {
    "local-mods": {
      "source": {
        "source": "directory",
        "path": "~/.claude/mods"
      }
    },
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    }
  },
  "language": "polish",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "light",
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
