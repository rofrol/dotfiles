{
  "permissions": {
    "allow": [
      "Bash(herdr agent awaiting-reply)",
      "Bash(herdr agent set-task:*)",
      "Bash(herdr agent awaiting-reply:*)",
      "Bash(herdr worker ack:*)",
      "Bash(herdr worker answer:*)",
      "Bash(herdr worker escalate:*)",
      "Bash(herdr worker wait:*)",
      "Bash(herdr worker status:*)",
      "Bash(herdr todo wait:*)",
      "Bash(herdr todo status:*)",
      "Bash(herdr todo resume:*)",
      "Bash(herdr-job wait:*)",
      "Bash(herdr agent wait:*)"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$HOME/personal_projects/roagent/bin:$PATH\"; notes=$(roagent handoff show --repo . 2>/dev/null) && if printf '%s\\n' \"$notes\" | grep -q '^  pending; unclaimed; owner '; then printf 'Pending handoff notes for this repository: use /handoff --take.\\n'; fi; exit 0"
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/romanfrolow/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/herdr-peer-token",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/herdr-bg-badge",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/herdr-peer-token",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/romanfrolow/.claude/hooks/uncommitted-notes.sh' check",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/romanfrolow/.claude/hooks/herdr-agent-state.sh' stop-check",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/herdr-bg-badge",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/romanfrolow/.claude/hooks/herdr-agent-state.sh' reminder",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/romanfrolow/.claude/hooks/uncommitted-notes.sh' record",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/romanfrolow/.claude/hooks/uncommitted-notes.sh' compare",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/romanfrolow/.claude/hooks/herdr-agent-state.sh' plan",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/romanfrolow/.claude/hooks/uncommitted-notes.sh' snapshot",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/delay-check.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/romanfrolow/.claude/hooks/herdr-agent-state.sh' pre-tool",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/question-preview.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/romanfrolow/.claude/hooks/herdr-agent-state.sh' session-end",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "^(rate_limit|billing_error)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/romanfrolow/.claude/hooks/herdr-agent-state.sh' stop-failure",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "jq -r '\"\\(.model.display_name) · \\(.workspace.current_dir | sub(env.HOME; \"~\"))\"'"
  },
  "enabledPlugins": {
    "shell-path-completion@local-mods": true,
    "typesafe@typesafe-ai": true
  },
  "extraKnownMarketplaces": {
    "local-mods": {
      "source": {
        "source": "directory",
        "path": "~/.claude/mods"
      }
    },
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    }
  },
  "language": "polish",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "light",
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
