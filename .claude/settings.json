{
  "permissions": {
    "allow": [
      "Bash(herdr agent awaiting-reply)",
      "Bash(herdr agent set-task:*)",
      "Bash(herdr agent awaiting-reply:*)"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/romanfrolow/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/herdr-peer-token",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/herdr-bg-badge",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/herdr-peer-token",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/romanfrolow/.claude/hooks/uncommitted-notes.sh' check",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/romanfrolow/.claude/hooks/herdr-agent-state.sh' stop-check",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/agent-queue.py stop",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/herdr-bg-badge",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/romanfrolow/.claude/hooks/herdr-agent-state.sh' reminder",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/romanfrolow/.claude/hooks/uncommitted-notes.sh' record",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/romanfrolow/.claude/hooks/uncommitted-notes.sh' compare",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/romanfrolow/.claude/hooks/herdr-agent-state.sh' plan",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/romanfrolow/.claude/hooks/uncommitted-notes.sh' snapshot",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/agent-queue.py guard",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/romanfrolow/.claude/hooks/herdr-agent-state.sh' session-end",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "^(rate_limit|billing_error)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/romanfrolow/.claude/hooks/herdr-agent-state.sh' stop-failure",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "jq -r '\"\\(.model.display_name) · \\(.workspace.current_dir | sub(env.HOME; \"~\"))\"'"
  },
  "language": "polish",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "light",
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
