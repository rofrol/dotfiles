# Automatic dotfiles repo: ~/scripts/dotfiles-shim/git picks the dotfiles repo
# per git call when the cwd is $HOME or a dir not ignored by .dotfiles.gitignore
# (and not inside another repo). GIT_DIR is not exported, so programs started
# here (lazygit, nvim, agents) see the right repo wherever they run git.
# Sourced by ~/.zshrc. Disable with DOTFILES_AUTO=0; `don` still forces it.

export DOTFILES_AUTO=1
# first in PATH, also after brew shellenv / nvm reorder it
path=("$HOME/scripts/dotfiles-shim" ${path:#$HOME/scripts/dotfiles-shim})
rehash

# The policy is not loaded here: Pi gets it from the user extension
# ~/.pi/agent/extensions/dotfiles-policy.ts, which checks the git root itself and
# works regardless of PATH (Herdr launches Pi with ~/.pi/agent/bin first, so a shim
# in this directory was bypassed). Do not add a pi() function or a pi shim here:
# they would append the policy a second time.

# This git shim only works while it is first in PATH: a later reorder (brew
# shellenv, nvm) would silently run the real git instead. Warn, do not fix,
# because reordering mid-startup could fight another tool.
if [[ $(whence -p git) != "$HOME/scripts/dotfiles-shim/git" ]]; then
	print -u2 "dotfiles-shim: 'git' resolves to $(whence -p git 2>/dev/null); expected $HOME/scripts/dotfiles-shim/git"
fi
