# Automatic dotfiles repo: ~/scripts/dotfiles-shim/git picks the dotfiles repo
# per git call when the cwd is $HOME or a dir not ignored by .dotfiles.gitignore
# (and not inside another repo). GIT_DIR is not exported, so programs started
# here (lazygit, nvim, agents) see the right repo wherever they run git.
# Sourced by ~/.zshrc. Disable with DOTFILES_AUTO=0; `don` still forces it.

export DOTFILES_AUTO=1
# first in PATH, also after brew shellenv / nvm reorder it
path=("$HOME/scripts/dotfiles-shim" ${path:#$HOME/scripts/dotfiles-shim})
rehash

pi() {
	# pi detects subcommands only as argv[0] – do not prepend the flag
	case ${1-} in
		install|remove|uninstall|update|list|config|auth) command pi "$@"; return ;;
	esac

	local root policy="$HOME/AGENTS.policy.md"
	# git root via the shim (or GIT_DIR in `don` mode), like lazygit sees it
	root=$(git rev-parse --show-toplevel 2>/dev/null)
	if [[ -n $root && $root -ef $HOME && -r $policy ]]; then
		command pi --append-system-prompt "$policy" "$@"
	else
		command pi "$@"
	fi
}
