<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Seconds of silence between songs in MPD (~/scripts/mpd-gap). Started by `music-companions install`.
     Change the length in the --seconds argument, then `music-companions install` (or launchctl kickstart -k). -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.rofrol.mpd-gap</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>PATH="$HOME/.local/bin:$HOME/.cargo/bin:/opt/homebrew/bin:$PATH"; exec "$HOME/scripts/mpd-gap" --seconds 3 &gt;&gt;"$HOME/Library/Logs/mpd-gap.log" 2&gt;&amp;1</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<!-- restarted when MPD is down or restarts; 10 s between attempts -->
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<!-- not Background: Background lets macOS coalesce timers, which would stretch the silence -->
	<key>ProcessType</key>
	<string>Standard</string>
</dict>
</plist>
