#!/usr/bin/env python3
"""aq: a per-project queue of work the user approved for agents.

The user adds items; a worker session (started with `aq worker`) takes them
one by one through the Claude Code Stop hook (~/.claude/hooks/agent-queue.sh)
and reports each as done or blocked, with any remarks, questions or
leftovers in its notes. Adding an item is the user's approval for that work,
including its commits; that is why only the user may add items:
`aq add` refuses to run without a terminal or inside an agent session, and a
PreToolUse hook stops agents from running it or editing the queue files.

Usage:
  aq add [-p PROJECT] TEXT            add an item (the user, in a terminal)
  aq status [-p PROJECT] [--all]      blocked items and notes first
  aq worker [-p PROJECT]              start a Claude Code worker in this repository
  aq take [-p PROJECT] --session ID   hand the next ready item to a session (the hook)
  aq report ID done|blocked --notes TEXT    close the item this session works on
  aq current --session ID             the item a session works on, if any

PROJECT defaults to the name of the Git repository around the working
directory. The queue is an append-only event log per project in
~/.local/state/agent-queue/PROJECT.jsonl, so it is also the trace of who
added, took and reported what, and when.
"""

import argparse
import fcntl
import json
import os
import subprocess
import sys
from contextlib import contextmanager
from datetime import datetime, timezone
from pathlib import Path

STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")) / "agent-queue"


def now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def default_project() -> str:
    try:
        top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True)
        return Path(top.stdout.strip()).name
    except (subprocess.CalledProcessError, FileNotFoundError):
        sys.exit("aq: not in a Git repository; pass -p PROJECT")


@contextmanager
def queue(project: str):
    """The project's events, under an exclusive lock, and a function that
    appends one. Two workers taking at once get different items."""
    STATE.mkdir(parents=True, exist_ok=True)
    path = STATE / f"{project}.jsonl"
    with open(STATE / f"{project}.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        events = [json.loads(line) for line in path.open()] if path.exists() else []

        def append(event: dict) -> None:
            event = {"at": now(), **event}
            with path.open("a") as f:
                f.write(json.dumps(event, ensure_ascii=False) + "\n")
            events.append(event)

        yield events, append


def items(events: list[dict]) -> dict[str, dict]:
    """Current state of every item, folded from the event log."""
    state: dict[str, dict] = {}
    for e in events:
        if e["type"] == "add":
            state[e["id"]] = {"id": e["id"], "text": e["text"], "status": "ready", "added": e["at"]}
        elif e["type"] == "take":
            state[e["id"]].update(status="in progress", session=e["session"], taken=e["at"])
        elif e["type"] == "report":
            state[e["id"]].update(status=e["status"], notes=e["notes"], reported=e["at"])
    return state


def find(item_id: str) -> tuple[str, str]:
    project, _, _ = item_id.partition("#")
    if not project or not (STATE / f"{project}.jsonl").exists():
        sys.exit(f"aq: no queue item {item_id}")
    return project, item_id


def cmd_add(args) -> None:
    if os.environ.get("CLAUDECODE") or os.environ.get("AQ_WORKER") or not sys.stdin.isatty():
        sys.exit("aq: only the user adds items, from a terminal (adding one approves the work)")
    with queue(args.project) as (events, append):
        n = sum(1 for e in events if e["type"] == "add") + 1
        item_id = f"{args.project}#{n}"
        append({"type": "add", "id": item_id, "text": " ".join(args.text)})
    print(f"added {item_id}")


def cmd_take(args) -> None:
    with queue(args.project) as (events, append):
        state = items(events)
        mine = [i for i in state.values() if i["status"] == "in progress" and i.get("session") == args.session]
        if mine:
            print(json.dumps(mine[0], ensure_ascii=False))
            return
        ready = [i for i in state.values() if i["status"] == "ready"]
        if not ready:
            return
        item = ready[0]
        append({"type": "take", "id": item["id"], "session": args.session})
        item.update(status="in progress", session=args.session)
        print(json.dumps(item, ensure_ascii=False))


def cmd_current(args) -> None:
    for path in STATE.glob("*.jsonl") if STATE.exists() else []:
        with queue(path.stem) as (events, _):
            for item in items(events).values():
                if item["status"] == "in progress" and item.get("session") == args.session:
                    print(json.dumps(item, ensure_ascii=False))
                    return


def cmd_report(args) -> None:
    project, item_id = find(args.id)
    session = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    with queue(project) as (events, append):
        item = items(events).get(item_id)
        if not item or item["status"] != "in progress":
            sys.exit(f"aq: {item_id} is not in progress")
        if session and item.get("session") != session:
            sys.exit(f"aq: {item_id} belongs to another session")
        append({"type": "report", "id": item_id, "status": args.status, "notes": args.notes, "session": session})
    print(f"{item_id} {args.status}")


def cmd_status(args) -> None:
    with queue(args.project) as (events, _):
        state = list(items(events).values())
    order = {"blocked": 0, "in progress": 1, "ready": 2, "done": 3}
    shown = [i for i in state if args.all or i["status"] != "done" or i.get("notes")]
    if not shown:
        print(f"{args.project}: queue empty")
    for i in sorted(shown, key=lambda i: (order[i["status"]], i["id"])):
        print(f"{i['id']:12} {i['status']:11} {i['text']}")
        if i.get("notes"):
            for line in i["notes"].splitlines():
                print(f"{'':25}{line}")


def cmd_worker(args) -> None:
    prompt = (f"You are a worker for the agent queue of {args.project}. Do nothing else: end your turn now; "
              "the Stop hook hands you the queue items one at a time with instructions.")
    os.execvpe("claude", ["claude", "--name", f"queue: {args.project}", prompt],
               {**os.environ, "AQ_WORKER": args.project})


def main() -> None:
    parser = argparse.ArgumentParser(prog="aq", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    for name in ("add", "status", "worker", "take"):
        p = sub.add_parser(name)
        p.add_argument("-p", "--project")
        if name == "add":
            p.add_argument("text", nargs="+")
        if name == "status":
            p.add_argument("--all", action="store_true")
        if name == "take":
            p.add_argument("--session", required=True)
    c = sub.add_parser("current")
    c.add_argument("--session", required=True)
    r = sub.add_parser("report")
    r.add_argument("id")
    r.add_argument("status", choices=["done", "blocked"])
    r.add_argument("--notes", required=True)
    args = parser.parse_args()
    if hasattr(args, "project") and not args.project:
        args.project = default_project()
    {"add": cmd_add, "status": cmd_status, "worker": cmd_worker, "take": cmd_take, "current": cmd_current,
     "report": cmd_report}[args.command](args)


if __name__ == "__main__":
    main()
