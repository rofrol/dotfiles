#!/bin/sh
# List a Blu-ray backup's playlists: track count, minutes, file. The main
# feature has all tracks (video, audio, dubs, subtitles) and the film's
# running time, so it sorts first: most tracks, then longest. A long
# playlist with one track is a loop of a short clip.
# Usage: bluray-playlists [DISC]   (DISC contains BDMV/, default: .)
# Needs mkvmerge (brew install mkvtoolnix) and jq.
set -eu

disc=${1:-.}
dir="$disc/BDMV/PLAYLIST"
[ -d "$dir" ] || { echo "bluray-playlists: no $dir" >&2; exit 1; }

for f in "$dir"/*.mpls; do
	mkvmerge -J "$f" | jq -r --arg f "$f" \
		'(.tracks | length) as $n
		 | "\($n) track\(if $n == 1 then "" else "s" end)\t\((.container.properties.playlist_duration // 0) / 6e10 | round) min\t\($f)"'
done | sort -t "$(printf '\t')" -k1,1nr -k2,2nr | head
