#!/usr/bin/env python3
"""How full this agent session's context window is, from its own transcript.

    context-usage            print "<percent>% (<tokens> of <window> tokens, <model>, <agent>)"
    context-usage --percent  print only the whole percent

Run it from a command the agent itself runs: pi sets $PI_SESSION_FILE,
Claude Code sets $CLAUDE_CODE_SESSION_ID (its transcript is
~/.claude/projects/*/<id>.jsonl). The tokens are the last main-thread
assistant turn's prompt plus output (input, cache reads and writes, output),
which is what the next turn sends again; the window is the model's context
length from `pi --list-models` (CONTEXT_WINDOW overrides it, in tokens).

Exit 0 with a value; 2 when this is not an agent session, the transcript has
no turn with usage yet, or a compaction follows the last one (the size is
unknown until the next turn); 3 when the model's window is unknown.

Used by the global rule "Context size and handoff" and the `todo` skill's
automatic handoff (hand off over about 70%)."""
import glob, json, os, re, subprocess, sys


def last_turn_pi(path):
    usage = model = None
    with open(path) as f:
        for line in f:
            try:
                e = json.loads(line)
            except json.JSONDecodeError:
                continue
            if e.get("type") == "compaction":
                usage = None  # the context was rebuilt; the old size no longer holds
                continue
            m = e.get("message") or {}
            u = m.get("usage") or {}
            if e.get("type") == "message" and m.get("role") == "assistant" and u.get("totalTokens"):
                tokens = sum(u.get(k, 0) for k in ("input", "output", "cacheRead", "cacheWrite"))
                usage, model = tokens, (m.get("provider", ""), m.get("model", ""))
    return usage, model


def last_turn_claude(session_id):
    paths = glob.glob(os.path.expanduser(f"~/.claude/projects/*/{glob.escape(session_id)}.jsonl"))
    if not paths:
        return None, None
    usage = model = None
    with open(max(paths, key=os.path.getmtime)) as f:
        for line in f:
            try:
                e = json.loads(line)
            except json.JSONDecodeError:
                continue
            if e.get("isSidechain"):
                continue
            if e.get("isCompactSummary") or (e.get("type") == "system" and e.get("subtype") == "compact_boundary"):
                usage = None
                continue
            m = e.get("message") or {}
            u = m.get("usage") or {}
            if e.get("type") == "assistant" and u:
                tokens = sum(u.get(k, 0) for k in ("input_tokens", "cache_creation_input_tokens",
                                                   "cache_read_input_tokens", "output_tokens"))
                if tokens:
                    usage, model = tokens, ("anthropic", m.get("model", ""))
    return usage, model


def window(provider, model):
    if os.environ.get("CONTEXT_WINDOW", "").isdigit():
        return int(os.environ["CONTEXT_WINDOW"])
    try:
        out = subprocess.run(["pi", "--list-models", model], capture_output=True, text=True).stdout
    except OSError:
        return None
    for row in out.splitlines()[1:]:
        cols = row.split()
        if len(cols) >= 3 and cols[0] == provider and cols[1] == model:
            m = re.fullmatch(r"([\d.]+)([KM]?)", cols[2])
            if m:
                return int(float(m[1]) * {"": 1, "K": 1_000, "M": 1_000_000}[m[2]])
    return None


def main():
    if os.environ.get("PI_SESSION_FILE"):
        agent = "pi"
        tokens, model = last_turn_pi(os.environ["PI_SESSION_FILE"])
    elif os.environ.get("CLAUDE_CODE_SESSION_ID"):
        agent = "claude"
        tokens, model = last_turn_claude(os.environ["CLAUDE_CODE_SESSION_ID"])
    else:
        print("context-usage: not run by a pi or Claude Code session", file=sys.stderr)
        return 2
    if tokens is None:
        print(f"context-usage: no {agent} turn with token usage since the start or the last compaction", file=sys.stderr)
        return 2
    size = window(*model)
    if not size:
        print(f"context-usage: unknown context window of {model[0]}/{model[1]}; set CONTEXT_WINDOW", file=sys.stderr)
        return 3
    percent = 100 * tokens // size
    if sys.argv[1:] == ["--percent"]:
        print(percent)
    else:
        print(f"{percent}% ({tokens} of {size} tokens, {model[0]}/{model[1]}, {agent})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
