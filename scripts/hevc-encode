#!/bin/sh
# Re-encode a film (e.g. a Blu-ray remux) to 10-bit HEVC with x265, keeping
# the grain, for playback on an Apple Silicon Mac: HEVC decodes in hardware
# there, AV1 does not (software AV1 in mpv cost about 3x the CPU).
# Audio becomes Opus 384k (5.1 stays 5.1), subtitles (unless -S)
# and chapters are copied.
# x265 gets 4 worker threads (pools=4) at nice 19, so the Mac stays cooler and
# usable, and caffeinate -i keeps it awake until the encode ends. nice 19 alone
# let x265 take all 10 cores of an M1 Pro (~690% CPU, 89 C, loud fan);
# taskpolicy -b was quiet but ~30x slower (0.15 fps), and taskpolicy -c utility
# did not limit it at all. Pause and resume with kill -STOP / -CONT PID.
# Usage: hevc-encode [-n] [-S] IN.mkv [OUT.mkv] [-- EXTRA FFMPEG OPTIONS]
#   OUT defaults to IN with _HEVC before the extension; -n prints the command;
#   -S leaves out the input's subtitles (e.g. when you keep your own .srt;
#   hevc-encode-no-subs is the same).
#   Extra options go before OUT, e.g. `-- -t 60` for a one-minute test clip.
# Settings (CRF 18, preset slow, no `tune grain`, psy-rd/psy-rdoq instead)
# and their measurements: kisswiki src/ffmpeg/hevc_encode_film.md.
set -eu

dry=
subs="-c:s copy"
while :; do
  case ${1:-} in
    -n) dry=1; shift ;;
    -S) subs="-map -0:s"; shift ;;
    *) break ;;
  esac
done
[ $# -ge 1 ] || { sed -n '2,/^set -eu/s/^# \{0,1\}//p' "$0" >&2; exit 2; }
in=$1; shift
out=${in%.*}_HEVC.mkv
[ $# -ge 1 ] && [ "$1" != -- ] && { out=$1; shift; }
[ "${1:-}" = -- ] && shift
[ -e "$out" ] && { echo "hevc-encode: $out exists" >&2; exit 1; }

# libopus refuses 5.1(side), the usual Blu-ray layout: relabel the side pair
# as the back pair (the same speakers in a home 5.1 setup), in every audio
# track that has it (a disc often carries the same mix twice, e.g. DTS-HD MA
# and AC3). With -map 0, output audio track N is input audio track N.
af=
n=0
while IFS= read -r layout; do
  case $layout in
    '5.1(side)') af="$af -filter:a:$n channelmap=channel_layout=5.1" ;;
    '5.0(side)') af="$af -filter:a:$n channelmap=channel_layout=5.0" ;;
  esac
  n=$((n + 1))
done <<EOF
$(ffprobe -v error -select_streams a -show_entries stream=channel_layout -of csv=p=0 "$in")
EOF

# $af and $subs are unquoted on purpose: they hold only the fixed option
# words set above, which contain no glob characters.
set -- caffeinate -i nice -n 19 ffmpeg -hide_banner -nostdin -i "$in" -map 0 \
  -c:v libx265 -pix_fmt yuv420p10le -preset slow -crf 18 \
  -x265-params "pools=4:no-sao=1:aq-mode=3:psy-rd=2.0:psy-rdoq=1.0:log-level=error" \
  $af -c:a libopus -b:a 384k -mapping_family 1 $subs "$@" "$out"
if [ -n "$dry" ]; then printf '%s\n' "$*"; else exec "$@"; fi
