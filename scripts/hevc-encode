#!/bin/sh
# Re-encode a film (e.g. a Blu-ray remux) to 10-bit HEVC with x265, keeping
# the grain, for playback on an Apple Silicon Mac: HEVC decodes in hardware
# there, AV1 does not (software AV1 in mpv cost about 3x the CPU).
# Audio becomes Opus 384k (5.1 stays 5.1), subtitles and chapters are copied.
# Runs at background QoS (taskpolicy -b: efficiency cores only, throttled I/O)
# so the Mac stays quiet and usable, and keeps it awake (caffeinate -i) until
# the encode ends. nice 19 was not enough: with nothing else running, x265
# still took all 10 cores of an M1 Pro (89 C, loud fan). A running encode can
# be moved with `taskpolicy -b -p PID` and paused with kill -STOP / -CONT.
# Usage: hevc-encode [-n] IN.mkv [OUT.mkv] [-- EXTRA FFMPEG OPTIONS]
#   OUT defaults to IN with _HEVC before the extension; -n prints the command.
#   Extra options go before OUT, e.g. `-- -t 60` for a one-minute test clip.
# Settings (CRF 18, preset slow, no `tune grain`, psy-rd/psy-rdoq instead)
# and their measurements: kisswiki src/ffmpeg/hevc_encode_film.md.
set -eu

dry=
[ "${1:-}" = -n ] && { dry=1; shift; }
[ $# -ge 1 ] || { sed -n '2,/^set -eu/s/^# \{0,1\}//p' "$0" >&2; exit 2; }
in=$1; shift
out=${in%.*}_HEVC.mkv
[ $# -ge 1 ] && [ "$1" != -- ] && { out=$1; shift; }
[ "${1:-}" = -- ] && shift
[ -e "$out" ] && { echo "hevc-encode: $out exists" >&2; exit 1; }

# libopus refuses 5.1(side), the usual Blu-ray layout: relabel the side pair
# of the first audio track as the back pair (the same speakers in a home 5.1
# setup). Only the first audio track is checked and filtered.
af=anull
case $(ffprobe -v error -select_streams a:0 -show_entries stream=channel_layout -of csv=p=0 "$in") in
  '5.1(side)') af=channelmap=channel_layout=5.1 ;;
  '5.0(side)') af=channelmap=channel_layout=5.0 ;;
esac

set -- caffeinate -i taskpolicy -b ffmpeg -hide_banner -nostdin -i "$in" -map 0 \
  -c:v libx265 -pix_fmt yuv420p10le -preset slow -crf 18 \
  -x265-params "no-sao=1:aq-mode=3:psy-rd=2.0:psy-rdoq=1.0:log-level=error" \
  -filter:a:0 "$af" -c:a libopus -b:a 384k -mapping_family 1 -c:s copy "$@" "$out"
if [ -n "$dry" ]; then printf '%s\n' "$*"; else exec "$@"; fi
