#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["python-mpd2"]
# ///
"""Silence of N seconds between songs in MPD, which has no such setting.

  mpd-gap [--seconds 3]     # runs until killed; started by the com.rofrol.mpd-gap LaunchAgent

While a song plays, single mode is set to oneshot. MPD 0.24 then pauses at 0:00 of the next song (in queue or
random order) when the song ends and resets single to off; after N seconds this resumes it. Nothing of the next
song is heard early. A user pause keeps single at oneshot and the song, so it is never resumed by this; anything
the user does during the silence (play, next, pause, another song) cancels it. Single on (1) and repeat on are
left alone. rormpc shows single as oneshot while this runs.
"""
import argparse, asyncio, os, time

from mpd.asyncio import MPDClient


async def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--seconds", type=float, default=3)
    a = ap.parse_args()
    c = MPDClient()
    await c.connect(os.environ.get("MPD_HOST", "localhost"), int(os.environ.get("MPD_PORT", 6600)))
    changed = asyncio.Event()

    async def watch():
        async for _ in c.idle(["player", "options"]):
            changed.set()

    watcher = asyncio.create_task(watch())
    armed_for = None  # songid whose end we asked MPD to pause after
    gap_until = None  # (songid paused at 0:00, monotonic deadline)
    while True:
        changed.clear()  # before reading the status: a change after it sets the event again
        s = await c.status()
        song = s.get("songid")
        if gap_until and (s["state"] != "pause" or song != gap_until[0]):
            gap_until = None  # the user did something during the silence
        if s["state"] == "play" and s.get("single") == "0" and s.get("repeat") == "0":
            await c.single("oneshot")
            armed_for = song
        elif (s["state"] == "pause" and s.get("single") == "0" and armed_for not in (None, song)
              and float(s.get("elapsed", 0)) == 0 and not gap_until):
            gap_until = (song, time.monotonic() + a.seconds)  # MPD paused at the start of the next song
            armed_for = None
        if gap_until and time.monotonic() >= gap_until[1]:
            gap_until = None
            await c.play()
            continue
        timeout = max(0.0, gap_until[1] - time.monotonic()) if gap_until else None
        try:
            await asyncio.wait_for(changed.wait(), timeout)
        except TimeoutError:
            pass
        if watcher.done():
            watcher.result()  # the connection is gone: raise, launchd restarts us


if __name__ == "__main__":
    asyncio.run(main())
