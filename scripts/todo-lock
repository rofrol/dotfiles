#!/usr/bin/env python3
"""One TODO coordinator per repository: a lock in the repository's git common
dir, shared by all its worktrees.

    todo-lock acquire [REPO]   take the lock for this herdr pane's agent, or
                               print who holds it and exit 1
    todo-lock release [REPO]   drop it, only if this pane's agent holds it
    todo-lock status  [REPO]   print the holder (exit 0) or "free" (exit 3)

REPO defaults to the current directory. The boundary is the git repository:
the lock is $(git rev-parse --git-common-dir)/todo-coordinator.lock, shared
by all worktrees of the clone, one line of JSON naming the holder, its cwd,
host, start time and a nonce.

The holder is the agent's process: the nearest ancestor named claude, pi or
codex, with its start time (so a reused pid does not count), inside herdr
or not. In herdr its pane is recorded too, for people reading the lock.
No agent process found means no lock.

It is taken atomically (link of a temp file; EEXIST means held). A lock is
stale only when its holder is gone: that process no longer runs with that
start time. That is
checked when someone tries to acquire, never by age or on a timer. A stale lock is moved aside with rename (atomic: one contender wins)
and the acquire is tried again. A lock from another host is never taken over.
Consult rounds 20261013-134450-4852 (MiMo, DeepSeek); the user's global rules,
"Working through TODO.md" and "Context size and handoff"."""
import json, os, platform, secrets, socket, subprocess, sys, time

AGENT_NAMES = ("claude", "pi", "codex")

MAX_TAKEOVERS = 3  # bound on the acquire loop; each pass needs a real stale lock


def git_common_dir(repo):
    out = subprocess.run(["git", "-C", repo, "rev-parse", "--path-format=absolute", "--git-common-dir"],
                         capture_output=True, text=True)
    if out.returncode != 0:
        sys.exit(f"todo-lock: {repo} is not a git repository")
    return out.stdout.strip()


def ps(pid, field):
    out = subprocess.run(["ps", "-o", f"{field}=", "-p", str(pid)], capture_output=True, text=True)
    return " ".join(out.stdout.split())


def start_time(pid):
    """The process's start time, or "" when it does not run."""
    if platform.system() == "Linux":
        try:
            with open(f"/proc/{pid}/stat") as f:
                return f.read().rsplit(")", 1)[1].split()[19]  # field 22: starttime
        except OSError:
            return ""
    return ps(pid, "lstart")


def agent_process():
    """The nearest ancestor that is an agent (claude, pi, codex)."""
    pid = os.getppid()
    for _ in range(32):  # bound: process trees are shallow
        if pid <= 1:
            return None
        name = os.path.basename(ps(pid, "comm"))
        if name in AGENT_NAMES:
            return pid, name
        parent = ps(pid, "ppid")
        if not parent.isdigit():
            return None
        pid = int(parent)
    return None


def me():
    """This agent's identity: its process, plus its herdr pane if any."""
    found = agent_process()
    if found is None:
        sys.exit("todo-lock: no agent process (claude, pi, codex) among this command's ancestors")
    pid, name = found
    ident = {"pid": pid, "pid_start": start_time(pid), "agent": name}
    pane = os.environ.get("HERDR_PANE_ID", "")
    if pane:
        ident["pane"] = pane
    return ident


def same_holder(a, b):
    return bool(a.get("pid_start")) and a.get("pid") == b.get("pid") and a.get("pid_start") == b.get("pid_start")


def read(path):
    try:
        with open(path) as f:
            return json.loads(f.read())
    except FileNotFoundError:
        return None
    except (json.JSONDecodeError, OSError):
        return {"unreadable": True}


def alive(holder):
    if holder.get("host") != socket.gethostname():
        return True  # cannot check another machine: treat as held
    if "pid_start" not in holder:
        return True  # not a lock this script wrote: leave it to a person
    return bool(holder["pid_start"]) and start_time(holder.get("pid")) == holder["pid_start"]


def describe(h):
    if h.get("unreadable"):
        return "an unreadable lock file"
    who = f"pid {h.get('pid')}" + (f", herdr pane {h['pane']}" if h.get("pane") else "")
    return f"{who} ({h.get('agent', '?')}) on {h.get('host')} since {h.get('started')}, cwd {h.get('cwd')}"


def acquire(lock):
    mine = {"v": 3, **me(), "cwd": os.getcwd(), "host": socket.gethostname(),
            "started": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "nonce": secrets.token_hex(8)}
    for _ in range(MAX_TAKEOVERS):
        tmp = f"{lock}.{os.getpid()}.tmp"
        with open(tmp, "w") as f:
            f.write(json.dumps(mine) + "\n")
            f.flush()
            os.fsync(f.fileno())
        try:
            os.link(tmp, lock)
            os.unlink(tmp)
            print(f"acquired: {describe(mine)}")
            return 0
        except FileExistsError:
            os.unlink(tmp)
        holder = read(lock)
        if holder is None:
            continue  # released between link and read: try again
        if not holder.get("unreadable") and same_holder(holder, mine):
            print(f"already held by this agent: {describe(holder)}")
            return 0
        if holder.get("unreadable") or alive(holder):
            print(f"held by {describe(holder)}")
            return 1
        try:
            os.rename(lock, f"{lock}.stale-{int(time.time())}-{os.getpid()}")
            print(f"took over a stale lock: {describe(holder)} (that agent is gone)", file=sys.stderr)
        except FileNotFoundError:
            pass  # another contender moved it first; re-evaluate
    print("todo-lock: gave up after repeated takeovers; check the lock by hand", file=sys.stderr)
    return 1


def release(lock):
    holder = read(lock)
    if holder is None:
        print("free")
        return 0
    if holder.get("unreadable") or not same_holder(holder, me()):
        print(f"not released: held by {describe(holder)}")
        return 1
    os.unlink(lock)
    print("released")
    return 0


def status(lock):
    holder = read(lock)
    if holder is None:
        print("free")
        return 3
    state = "" if holder.get("unreadable") or alive(holder) else " (stale: that agent is gone)"
    print(f"held by {describe(holder)}{state}")
    return 0


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in ("acquire", "release", "status"):
        sys.exit(__doc__)
    repo = sys.argv[2] if len(sys.argv) > 2 else "."
    lock = os.path.join(git_common_dir(repo), "todo-coordinator.lock")
    sys.exit({"acquire": acquire, "release": release, "status": status}[sys.argv[1]](lock))


if __name__ == "__main__":
    main()
