#!/usr/bin/env python3
"""One TODO coordinator per repository: a lock in the repository's git common
dir, shared by all its worktrees.

    todo-lock acquire [REPO]   take the lock for this herdr pane's agent, or
                               print who holds it and exit 1
    todo-lock release [REPO]   drop it, only if this pane's agent holds it
    todo-lock status  [REPO]   print the holder (exit 0) or "free" (exit 3)
    todo-lock handover [REPO]  mark this agent's lock as handed over and print
                               a one-time token for the successor
    todo-lock acquire --token TOKEN [REPO]
                               take over a lock handed over with that token

REPO defaults to the current directory. The boundary is the git repository:
the lock is $(git rev-parse --git-common-dir)/todo-coordinator.lock, shared
by all worktrees of the clone, one line of JSON naming the holder, its cwd,
host, start time and a nonce.

The holder is the agent's process: the nearest ancestor named claude, pi or
codex, with its start time (so a reused pid does not count), inside herdr
or not. In herdr its pane is recorded too, for people reading the lock.
No agent process found means no lock.

It is taken atomically (link of a temp file; EEXIST means held). A lock is
stale only when its holder is gone: that process no longer runs with that
start time. That is checked when someone tries to acquire, never by age or
on a timer. Every change to an existing lock (a stale takeover, a handover,
a release) first creates `<lock>.claim.<its nonce>` with O_EXCL, so one
session wins, re-reads the lock, and replaces it by rename (never leaving
the path empty) or removes it. A claim left by a crash blocks only that
lock; status shows it and a person removes it. A lock from another host is
never taken over.

A handover passes the lock with no moment when it is free: the holder
writes a random token into its lock (atomic rename over it) and puts the
token in its handoff note; the lock stays held by the predecessor, so a
plain acquire still fails, and only `acquire --token` with that token takes
it over, through the same claim as any other change. If the
predecessor exits before a successor comes, the lock is stale as usual and
the next acquire takes it (and the note with it); if the successor cannot
be started, the predecessor releases or keeps the lock. Consult round
20261013-150634-b1a5; the user approved it on 2026-10-13.

Consult rounds 20261013-134450-4852 (MiMo, DeepSeek); the user's global rules,
"Working through TODO.md" and "Context size and handoff"."""
import json, os, platform, secrets, socket, subprocess, sys, time

AGENT_NAMES = ("claude", "pi", "codex")

MAX_TAKEOVERS = 3  # bound on the acquire loop; each pass needs a real stale lock


def git_common_dir(repo):
    out = subprocess.run(["git", "-C", repo, "rev-parse", "--path-format=absolute", "--git-common-dir"],
                         capture_output=True, text=True)
    if out.returncode != 0:
        sys.exit(f"todo-lock: {repo} is not a git repository")
    return out.stdout.strip()


def ps(pid, field):
    out = subprocess.run(["ps", "-o", f"{field}=", "-p", str(pid)], capture_output=True, text=True)
    return " ".join(out.stdout.split())


def start_time(pid):
    """The process's start time, or "" when it does not run."""
    if platform.system() == "Linux":
        try:
            with open(f"/proc/{pid}/stat") as f:
                return f.read().rsplit(")", 1)[1].split()[19]  # field 22: starttime
        except OSError:
            return ""
    return ps(pid, "lstart")


def agent_process():
    """The nearest ancestor that is an agent (claude, pi, codex)."""
    pid = os.getppid()
    for _ in range(32):  # bound: process trees are shallow
        if pid <= 1:
            return None
        name = os.path.basename(ps(pid, "comm"))
        if name in AGENT_NAMES:
            return pid, name
        parent = ps(pid, "ppid")
        if not parent.isdigit():
            return None
        pid = int(parent)
    return None


def me():
    """This agent's identity: its process, plus its herdr pane if any."""
    found = agent_process()
    if found is None:
        sys.exit("todo-lock: no agent process (claude, pi, codex) among this command's ancestors")
    pid, name = found
    ident = {"pid": pid, "pid_start": start_time(pid), "agent": name}
    pane = os.environ.get("HERDR_PANE_ID", "")
    if pane:
        ident["pane"] = pane
    return ident


def same_holder(a, b):
    return bool(a.get("pid_start")) and a.get("pid") == b.get("pid") and a.get("pid_start") == b.get("pid_start")


def read(path):
    try:
        with open(path) as f:
            return json.loads(f.read())
    except FileNotFoundError:
        return None
    except (json.JSONDecodeError, OSError):
        return {"unreadable": True}


def alive(holder):
    if holder.get("host") != socket.gethostname():
        return True  # cannot check another machine: treat as held
    if "pid_start" not in holder:
        return True  # not a lock this script wrote: leave it to a person
    return bool(holder["pid_start"]) and start_time(holder.get("pid")) == holder["pid_start"]


def describe(h):
    if h.get("unreadable"):
        return "an unreadable lock file"
    who = f"pid {h.get('pid')}" + (f", herdr pane {h['pane']}" if h.get("pane") else "")
    text = f"{who} ({h.get('agent', '?')}) on {h.get('host')} since {h.get('started')}, cwd {h.get('cwd')}"
    if h.get("handover"):
        text += f", handing over since {h.get('handover_since')}"
    return text


def write_tmp(lock, data):
    tmp = f"{lock}.{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        f.write(json.dumps(data) + "\n")
        f.flush()
        os.fsync(f.fileno())
    return tmp


def new_holder():
    return {"v": 3, **me(), "cwd": os.getcwd(), "host": socket.gethostname(),
            "started": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "nonce": secrets.token_hex(8)}


def replace(lock, seen, new):
    """Replace the lock we read as `seen` with `new` (None removes it), or
    return False if anyone else changed or is changing it. The claim file
    `lock.claim.<nonce>` (created with O_EXCL) lets exactly one session
    replace a given lock; nonces are never reused, so a late contender sees
    a different nonce and backs off. The lock path is never empty except
    after a removal, so a plain link never slips in during a takeover."""
    nonce = seen.get("nonce")
    if not nonce:
        return False
    claim = f"{lock}.claim.{nonce}"
    try:
        fd = os.open(claim, os.O_WRONLY | os.O_CREAT | os.O_EXCL)
    except FileExistsError:
        return False
    try:
        os.write(fd, json.dumps(me()).encode())
        os.close(fd)
        if (read(lock) or {}).get("nonce") != nonce:
            return False
        if new is None:
            os.unlink(lock)
        else:
            os.rename(write_tmp(lock, new), lock)
        return True
    finally:
        os.unlink(claim)


def take_handover(lock, token):
    """Take over a lock handed over with this token, atomically."""
    holder = read(lock)
    if holder is None or holder.get("unreadable") or holder.get("handover") != token:
        print(f"no handover with that token: {'free' if holder is None else 'held by ' + describe(holder)}")
        return 1
    mine = new_holder()
    if not replace(lock, holder, mine):
        print(f"the handover was taken by another session: {describe(read(lock) or {})}")
        return 1
    print(f"acquired by handover: {describe(mine)}")
    return 0


def handover(lock):
    holder = read(lock)
    if holder is None or holder.get("unreadable") or not same_holder(holder, me()):
        print(f"not handed over: {'free' if holder is None else 'held by ' + describe(holder)}")
        return 1
    if holder.get("handover"):
        print(holder["handover"])
        return 0
    token = secrets.token_hex(16)
    if not replace(lock, holder, {**holder, "nonce": secrets.token_hex(8), "handover": token,
                                  "handover_since": time.strftime("%Y-%m-%dT%H:%M:%S%z")}):
        print("not handed over: the lock changed; run status")
        return 1
    print(token)
    return 0


def acquire(lock):
    mine = new_holder()
    for _ in range(MAX_TAKEOVERS):
        tmp = write_tmp(lock, mine)
        try:
            os.link(tmp, lock)
            os.unlink(tmp)
            print(f"acquired: {describe(mine)}")
            return 0
        except FileExistsError:
            os.unlink(tmp)
        holder = read(lock)
        if holder is None:
            continue  # released between link and read: try again
        if not holder.get("unreadable") and same_holder(holder, mine):
            print(f"already held by this agent: {describe(holder)}")
            return 0
        if holder.get("unreadable") or alive(holder):
            print(f"held by {describe(holder)}")
            return 1
        if replace(lock, holder, mine):
            print(f"took over a stale lock: {describe(holder)} (that agent is gone)", file=sys.stderr)
            print(f"acquired: {describe(mine)}")
            return 0
        # another contender is replacing it; re-evaluate
    print("todo-lock: gave up after repeated takeovers; check the lock by hand", file=sys.stderr)
    return 1


def release(lock):
    holder = read(lock)
    if holder is None:
        print("free")
        return 0
    if holder.get("unreadable") or not same_holder(holder, me()):
        print(f"not released: held by {describe(holder)}")
        return 1
    if not replace(lock, holder, None):
        print(f"not released: the lock changed: {describe(read(lock) or {})}")
        return 1
    print("released")
    return 0


def status(lock):
    holder = read(lock)
    if holder is None:
        print("free")
        return 3
    state = "" if holder.get("unreadable") or alive(holder) else " (stale: that agent is gone)"
    claim = f"{lock}.claim.{holder.get('nonce')}"
    try:
        with open(claim) as f:
            state += f"; being changed by {f.read()} (if that agent is gone, remove {claim})"
    except OSError:
        pass
    print(f"held by {describe(holder)}{state}")
    return 0


def main():
    args = sys.argv[1:]
    token = None
    if "--token" in args:
        at = args.index("--token")
        token = args[at + 1] if at + 1 < len(args) else ""
        del args[at:at + 2]
    if not args or args[0] not in ("acquire", "release", "status", "handover") or (token is not None and (args[0] != "acquire" or not token)):
        sys.exit(__doc__)
    repo = args[1] if len(args) > 1 else "."
    lock = os.path.join(git_common_dir(repo), "todo-coordinator.lock")
    if token is not None:
        sys.exit(take_handover(lock, token))
    sys.exit({"acquire": acquire, "release": release, "status": status, "handover": handover}[args[0]](lock))


if __name__ == "__main__":
    main()
