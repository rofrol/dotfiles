#!/usr/bin/env bash
# Opens a herdr tab in a space and starts a TODO coordinator there: it has
# worker agents do that repository's TODO items in order ("Rób TODO po
# kolei.", defined by the user's global agent rule "Working through TODO.md").
#
#   todo-worker SPACE [pi] [--dry-run]
#
# SPACE is a herdr space (workspace label). Claude starts with Remote Control
# (visible in the Claude app); `pi` starts pi with GPT-6.1 Sol instead. An
# agent already working that repository's TODO is reused, never doubled.
# Used by herdr's T button; in a session, the `todo` skill makes that session
# the coordinator instead.
set -euo pipefail

space=${1:?usage: todo-worker SPACE [pi] [--dry-run]}
kind=claude dry=
for arg in "${@:2}"; do
	case $arg in
	pi) kind=pi ;;
	--dry-run) dry=1 ;;
	*) echo "todo-worker: unknown argument $arg" >&2; exit 2 ;;
	esac
done
[ "${HERDR_ENV:-}" = 1 ] || { echo "todo-worker: not inside herdr" >&2; exit 1; }

workspace= repo=
read -r workspace repo < <(herdr workspace list | jq -r --arg s "$space" \
	'.result.workspaces[] | select(.label == $s) | [.workspace_id, (.worktree.checkout_path // "")] | @tsv') || true
[ -n "${workspace:-}" ] || { echo "todo-worker: no space named $space" >&2; exit 1; }
# herdr records a space's repository only after a worktree was created or
# opened from it; otherwise take the repository its first pane runs in.
if [ -z "${repo:-}" ]; then
	cwd=$(herdr pane list | jq -r --arg w "$workspace" \
		'[.result.panes[] | select(.workspace_id == $w) | .cwd // empty][0] // ""')
	[ -n "$cwd" ] && repo=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) || true
fi
[ -n "${repo:-}" ] || { echo "todo-worker: space $space has no repository" >&2; exit 1; }

# Agent names: [a-z][a-z0-9_-]{0,31}.
name=$(printf 'todo-%s' "$space" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_-' '-' | cut -c1-32)

existing=$(herdr agent list | jq -r --arg n "$name" --arg r "$repo" \
	'.result.agents[] | select(.name == $n or ((.name // "") | startswith("todo-")) and .cwd == $r) | .pane_id' | head -1)
if [ -n "$existing" ]; then
	echo "a TODO worker already runs for $space in pane $existing"
	exit 0
fi
# Any session coordinating this repository's TODO holds its todo-lock, also
# one the user started by hand; a live holder means no second coordinator.
# The started agent takes the lock itself (global rule "Working through
# TODO.md"); this check only avoids opening a tab that would be refused.
if holder=$("$HOME/scripts/todo-lock" status "$repo") && [[ $holder != *stale* ]]; then
	echo "the TODO of $space is already coordinated: $holder"
	exit 0
fi
# A pending handoff note is taken over first. The prompt decides; this only
# picks its wording, and the agent checks the note itself.
prompt="Rób TODO po kolei."
if grep -q '^Status: pending' "$repo/HANDOFF.md" 2>/dev/null; then
	prompt="Przejmij handoff z HANDOFF.md (najpierw todo-lock acquire i zajęcie notatki), potem rób TODO po kolei. Nie czytaj transkryptu poprzedniej sesji."
fi

if [ "$kind" = claude ]; then
	agent_args=(-- --remote-control "TODO $space")
else
	agent_args=(-- --model openai-codex/gpt-6.1-sol)
fi
if [ -n "$dry" ]; then
	echo "would open a tab in $workspace ($repo) and start $kind as $name: ${agent_args[*]}"
	exit 0
fi

created=$(herdr tab create --workspace "$workspace" --cwd "$repo" --no-focus)
pane=$(jq -r '.result.root_pane.pane_id' <<<"$created")
tab=$(jq -r '.result.tab.tab_id' <<<"$created")
where="space $space, tab $(jq -r '.result.tab.label // .result.tab.number' <<<"$created")"
# The agent coordinates the TODO: the sidebar marks its tab with ♛. A server
# without tab.set_role only leaves the mark out.
herdr tab role "$tab" coordinator >/dev/null 2>&1 || true

# Claude asks whether to trust a folder it has never opened (itself, a parent,
# or for a worktree its main checkout). Clicking T is not consent to trust it:
# the user answers that prompt in the new tab, and nothing here writes
# ~/.claude.json or answers for them.
trusted=1
if [ "$kind" = claude ]; then
	main=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || main=
	main=${main%/.git}
	trusted=$(jq -r --arg r "$repo" --arg m "${main:-$repo}" '[.projects // {} | to_entries[]
		| select(.value.hasTrustDialogAccepted == true) | .key as $k
		| select([$r, $m] | any(. == $k or startswith($k + "/")))] | if length > 0 then 1 else 0 end' \
		"$HOME/.claude.json" 2>/dev/null || echo 0)
fi
if [ "$trusted" != 1 ]; then
	herdr tab focus "$tab" >/dev/null 2>&1 || true
	echo "answer Claude's folder-trust prompt in the new TODO tab; the TODO starts after it"
	echo "($where, $repo)"
fi

if ! herdr agent start "$name" --kind "$kind" --pane "$pane" "${agent_args[@]}" >/dev/null 2>&1; then
	status=$(herdr agent list | jq -r --arg p "$pane" '.result.agents[] | select(.pane_id == $p) | .agent_status' | head -1)
	if [ "$status" != blocked ]; then
		echo "todo-worker: $kind did not start in $where; the TODO was not sent" >&2
		exit 1
	fi
	# Blocked at startup: a trust prompt (or another one) waits for the user.
	# Give them 10 minutes, the user's time to answer.
	[ "$trusted" = 1 ] && { herdr tab focus "$tab" >/dev/null 2>&1 || true; echo "answer $kind's startup prompt in the new TODO tab ($where); the TODO starts after it"; }
	if ! out=$(herdr agent wait "$pane" --until idle --timeout 600000 2>&1); then
		case $out in
		*agent_not_running*) why="$kind exited (the prompt was refused)" ;;
		*timeout*) why="the startup prompt was not answered within 10 minutes" ;;
		*) why="$kind did not become ready" ;;
		esac
		echo "todo-worker: $why in $where; the TODO was not sent" >&2
		exit 1
	fi
fi

# herdr can report a prompt as delivered that the agent never received, so a
# prompt counts as sent only once the agent starts working on it. 15 s is
# ample for a ready agent to pick up a submitted prompt; one resend at most.
# A refused trust prompt can pass for ready on its way out, so an agent gone
# from the pane means the prompt was refused, not lost.
landed=
for _ in 1 2; do
	if ! out=$(herdr agent prompt "$pane" "$prompt" 2>&1 >/dev/null); then
		case $out in
		*agent_not_running* | *not_found*)
			echo "todo-worker: $kind exited in $where (a startup prompt refused?); the TODO was not sent" >&2
			exit 1 ;;
		esac
		continue
	fi
	if herdr agent wait "$pane" --until working --timeout 15000 >/dev/null 2>&1; then
		landed=1
		break
	fi
done
if [ -z "$landed" ] && ! herdr agent list | jq -e --arg p "$pane" '.result.agents[] | select(.pane_id == $p)' >/dev/null; then
	echo "todo-worker: $kind exited in $where (a startup prompt refused?); the TODO was not sent" >&2
	exit 1
fi
if [ -z "$landed" ]; then
	echo "todo-worker: $kind started in $where but did not take the TODO prompt; type \"$prompt\" there" >&2
	exit 1
fi
echo "started $kind as $name in $where ($repo)"
[ "$kind" = claude ] && echo "Remote Control session: TODO $space"
exit 0
