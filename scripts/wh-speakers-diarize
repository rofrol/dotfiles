#!/usr/bin/env -S uv run --script

# /// script
# requires-python = ">=3.11,<3.15"
# dependencies = [
#     "mlx-whisper",
#     "numpy",
#     "pyannote.audio==4.0.7",
#     "python-dotenv",
#     "torch>=2.11",
#     "torchcodec>=0.16,<0.17",
# ]
# ///

import argparse
import builtins
import importlib
import json
import os
import subprocess
import sys
from pathlib import Path

import numpy as np
import torch
from dotenv import load_dotenv
from pyannote.audio import Pipeline
from pyannote.audio.pipelines.utils.hook import ProgressHook


WHISPER_MODEL = "mlx-community/whisper-large-v3-mlx"
DIARIZATION_MODEL = "pyannote/speaker-diarization-community-1"
SAMPLE_RATE = 16_000

# Words with no overlapping turn are attributed to the nearest
# turn only when it is this close; otherwise they stay unassigned.
MAX_NEAREST_SPEAKER_GAP = 0.25

# A different speaker's turn this much farther away than the nearest
# one still competes with it, so the word stays unassigned.
MIN_NEAREST_SPEAKER_MARGIN = 0.1

# Overlap assignments covering less of the word are ambiguous.
MIN_STRONG_OVERLAP_RATIO = 0.5

# A turn counts as overlapping a word only when it shares at least
# this long or this fraction of it, so boundary jitter between
# Whisper and pyannote does not look like simultaneous speech.
MIN_SPEAKER_OVERLAP = 0.05
MIN_SPEAKER_OVERLAP_RATIO = 0.25

# Same-speaker words further apart start a new utterance.
UTTERANCE_MAX_GAP = 0.7


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Transcribe audio with MLX Whisper and perform "
            "speaker diarization with pyannote."
        ),
        epilog="""
Hugging Face setup:

  1. Accept the diarization model terms:
     https://huggingface.co/pyannote/speaker-diarization-community-1

  2. Create an access token:
     https://huggingface.co/settings/tokens

  3. Create a .env file next to this script:

     HF_TOKEN=hf_xxxxxxxxxxxxxxxxx

The token must belong to the same Hugging Face account
that accepted access to the gated pyannote model.

Examples:

  wh-speakers-diarize discussion.mp3

  wh-speakers-diarize discussion.mp3 --language en

  wh-speakers-diarize ~/Downloads/youtube
""",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )

    parser.add_argument(
        "input",
        type=Path,
        help=(
            "Audio file or directory. When a directory is given, "
            "the most recently modified file is used."
        ),
    )

    parser.add_argument(
        "--language",
        default="en",
        help="Whisper language code (default: en).",
    )

    return parser.parse_args()


def load_hf_token() -> str:
    # Load .env located next to this script.
    script_dir = Path(__file__).resolve().parent
    env_file = script_dir / ".env"

    load_dotenv(
        env_file,
        override=True,
    )

    hf_token = os.environ.get("HF_TOKEN")

    if not hf_token:
        raise SystemExit(
            f"HF_TOKEN is not set.\n\n"
            f"Create:\n"
            f"  {env_file}\n\n"
            f"with:\n"
            f"  HF_TOKEN=hf_xxxxxxxxxxxxxxxxx\n\n"
            f"Run --help for Hugging Face setup instructions."
        )

    return hf_token


def resolve_input(input_path: Path) -> Path:
    input_path = input_path.expanduser().resolve()

    if input_path.is_dir():
        os.chdir(input_path)

        files = [
            path
            for path in Path(".").iterdir()
            if path.is_file()
        ]

        if not files:
            raise SystemExit(
                f"No files found in {input_path}"
            )

        file = max(
            files,
            key=lambda path: path.stat().st_mtime,
        )

        print(f"FILE={file}")

        return file.resolve()

    if not input_path.is_file():
        raise SystemExit(
            f"File does not exist: {input_path}"
        )

    os.chdir(input_path.parent)

    return Path(input_path.name).resolve()


def decode_audio(file: Path) -> dict:
    """Decode audio with system FFmpeg for pyannote."""

    command = [
        "ffmpeg",
        "-hide_banner",
        "-loglevel",
        "error",
        "-i",
        str(file),
        "-vn",
        "-ac",
        "1",
        "-ar",
        str(SAMPLE_RATE),
        "-f",
        "f32le",
        "-",
    ]

    try:
        result = subprocess.run(
            command,
            check=True,
            stdout=subprocess.PIPE,
        )
    except FileNotFoundError:
        raise SystemExit(
            "ffmpeg not found. Install it with:\n"
            "  brew install ffmpeg"
        )
    except subprocess.CalledProcessError as error:
        raise SystemExit(
            f"ffmpeg failed with exit code "
            f"{error.returncode}"
        )

    samples = np.frombuffer(
        result.stdout,
        dtype=np.float32,
    ).copy()

    waveform = torch.from_numpy(
        samples
    ).unsqueeze(0)

    return {
        "waveform": waveform,
        "sample_rate": SAMPLE_RATE,
    }


def transcribe_with_progress(
    file: Path,
    language: str,
) -> dict:
    """Run MLX Whisper with live text and a sticky progress bar."""

    mlx_transcribe = importlib.import_module(
        "mlx_whisper.transcribe"
    )

    original_tqdm = mlx_transcribe.tqdm.tqdm
    original_print = getattr(
        mlx_transcribe,
        "print",
        None,
    )

    def tqdm_with_progress(*args, **kwargs):
        # Force the progress bar even when verbose=True.
        kwargs["disable"] = False
        kwargs["dynamic_ncols"] = True
        kwargs["file"] = sys.stdout

        return original_tqdm(
            *args,
            **kwargs,
        )

    def tqdm_print(*args, **kwargs):
        output_file = kwargs.get("file")

        if output_file not in (
            None,
            sys.stdout,
        ):
            builtins.print(
                *args,
                **kwargs,
            )
            return

        separator = kwargs.get(
            "sep",
            " ",
        )

        end = kwargs.get(
            "end",
            "\n",
        )

        message = separator.join(
            str(arg)
            for arg in args
        )

        original_tqdm.write(
            message,
            file=sys.stdout,
            end=end,
        )

    mlx_transcribe.tqdm.tqdm = (
        tqdm_with_progress
    )

    mlx_transcribe.print = tqdm_print

    try:
        return mlx_transcribe.transcribe(
            str(file),
            path_or_hf_repo=WHISPER_MODEL,
            language=language,
            condition_on_previous_text=False,
            word_timestamps=True,
            hallucination_silence_threshold=2,
            verbose=True,
        )
    finally:
        mlx_transcribe.tqdm.tqdm = (
            original_tqdm
        )

        if original_print is None:
            delattr(
                mlx_transcribe,
                "print",
            )
        else:
            mlx_transcribe.print = (
                original_print
            )


def json_default(value):
    """Convert NumPy values into JSON-compatible values."""

    if isinstance(
        value,
        np.generic,
    ):
        return value.item()

    if isinstance(
        value,
        np.ndarray,
    ):
        return value.tolist()

    raise TypeError(
        f"Cannot serialize "
        f"{type(value).__name__}"
    )


def save_json(
    path: Path,
    data: dict,
) -> None:
    """Write JSON atomically."""

    temporary_path = path.with_name(
        path.name + ".tmp"
    )

    with temporary_path.open(
        "w",
        encoding="utf-8",
    ) as output:
        json.dump(
            data,
            output,
            ensure_ascii=False,
            indent=2,
            default=json_default,
        )

    temporary_path.replace(path)


def load_or_transcribe(
    file: Path,
    language: str,
) -> dict:
    transcription_path = file.with_suffix(
        ".whisper.json"
    )

    if transcription_path.exists():
        print(
            "Loading cached transcription: "
            f"{transcription_path}",
            file=sys.stderr,
        )

        with transcription_path.open(
            "r",
            encoding="utf-8",
        ) as input_file:
            return json.load(
                input_file
            )

    print(
        "Transcribing with MLX Whisper...",
        file=sys.stderr,
    )

    transcription = transcribe_with_progress(
        file,
        language,
    )

    save_json(
        transcription_path,
        transcription,
    )

    print(
        "\nSaved transcription cache: "
        f"{transcription_path}",
        file=sys.stderr,
    )

    return transcription


def overlap(
    start_a: float,
    end_a: float,
    start_b: float,
    end_b: float,
) -> float:
    return max(
        0.0,
        min(
            end_a,
            end_b,
        )
        - max(
            start_a,
            start_b,
        ),
    )


def interval_distance(
    start_a: float,
    end_a: float,
    start_b: float,
    end_b: float,
) -> float:
    """Edge-to-edge gap between two intervals (0 if they touch)."""

    if end_a < start_b:
        return start_b - end_a

    if end_b < start_a:
        return start_a - end_b

    return 0.0


def turns_to_dicts(
    annotation,
) -> list[dict]:
    return [
        {
            "start": float(
                turn.start
            ),
            "end": float(
                turn.end
            ),
            "speaker": speaker,
        }
        for turn, _, speaker
        in annotation.itertracks(
            yield_label=True
        )
    ]


def significant_overlap(
    shared: float,
    duration: float,
) -> bool:
    return shared >= min(
        MIN_SPEAKER_OVERLAP,
        MIN_SPEAKER_OVERLAP_RATIO
        * duration,
    ) and shared > 0


def contains_point(
    turn: dict,
    time: float,
) -> bool:
    # Half-open, so a point on a shared boundary belongs
    # only to the turn that starts there.
    return (
        turn["start"]
        <= time
        < turn["end"]
    )


def active_speakers(
    start: float,
    end: float,
    diarization: list[dict],
) -> list[str]:
    """Speakers whose turns overlap the word (or contain it,
    for zero-length words)."""

    speakers = set()

    for turn in diarization:
        if end > start:
            hit = significant_overlap(
                overlap(
                    start,
                    end,
                    turn["start"],
                    turn["end"],
                ),
                end - start,
            )
        else:
            hit = contains_point(
                turn,
                start,
            )

        if hit:
            speakers.add(
                turn["speaker"]
            )

    return sorted(speakers)


def assign_speaker(
    start: float,
    end: float,
    diarization: list[dict],
) -> dict:
    """Pick the primary speaker from exclusive diarization and
    describe how the choice was made."""

    duration = end - start
    per_speaker: dict[str, float] = {}
    containing = set()

    for turn in diarization:
        shared = overlap(
            start,
            end,
            turn["start"],
            turn["end"],
        )

        if shared > 0:
            per_speaker[turn["speaker"]] = (
                per_speaker.get(
                    turn["speaker"],
                    0.0,
                )
                + shared
            )
        elif (
            duration <= 0
            and contains_point(
                turn,
                start,
            )
        ):
            containing.add(
                turn["speaker"]
            )

    if per_speaker:
        speaker, shared = max(
            per_speaker.items(),
            key=lambda item: item[1],
        )
        ratio = shared / duration

        competing = [
            other
            for other, other_shared
            in per_speaker.items()
            if other != speaker
            and significant_overlap(
                other_shared,
                duration,
            )
        ]

        return {
            "speaker": speaker,
            "method": "overlap",
            "overlap_duration": round(
                shared, 3
            ),
            "overlap_ratio": round(
                min(ratio, 1.0), 3
            ),
            "distance": 0.0,
            "ambiguous": (
                ratio
                < MIN_STRONG_OVERLAP_RATIO
                or bool(competing)
            ),
        }

    if containing:
        # Zero-length word inside a turn. Exclusive turns do not
        # overlap, so at most one contains it. Whisper gives zero
        # length when word alignment failed, so the timing is weak
        # evidence.
        speaker = min(containing)

        return {
            "speaker": speaker,
            "method": "overlap",
            "overlap_duration": 0.0,
            "overlap_ratio": 1.0,
            "distance": 0.0,
            "ambiguous": True,
        }

    # Closest turn distance per speaker.
    distances: dict[str, float] = {}

    for turn in diarization:
        distance = interval_distance(
            start,
            end,
            turn["start"],
            turn["end"],
        )

        if distance < distances.get(
            turn["speaker"],
            float("inf"),
        ):
            distances[
                turn["speaker"]
            ] = distance

    ranked = sorted(
        distances.items(),
        key=lambda item: item[1],
    )

    nearest = (
        {"speaker": ranked[0][0]}
        if ranked
        else None
    )
    nearest_distance = (
        ranked[0][1]
        if ranked
        else None
    )

    contested = (
        len(ranked) > 1
        and ranked[1][1]
        - nearest_distance
        < MIN_NEAREST_SPEAKER_MARGIN
    )

    if (
        nearest is not None
        and nearest_distance
        <= MAX_NEAREST_SPEAKER_GAP
        and not contested
    ):
        return {
            "speaker": nearest["speaker"],
            "method": "nearest",
            "overlap_duration": 0.0,
            "overlap_ratio": 0.0,
            "distance": round(
                nearest_distance, 3
            ),
            "ambiguous": True,
        }

    return {
        "speaker": None,
        "method": "unassigned",
        "overlap_duration": 0.0,
        "overlap_ratio": 0.0,
        "distance": (
            round(nearest_distance, 3)
            if nearest is not None
            else None
        ),
        "ambiguous": True,
    }


def build_words(
    transcription: dict,
    exclusive_diarization: list[dict],
    speaker_diarization: list[dict],
) -> list[dict]:
    words = []

    for segment in transcription[
        "segments"
    ]:
        for word in segment.get(
            "words",
            [],
        ):
            start = word.get(
                "start"
            )

            end = word.get(
                "end"
            )

            if (
                start is None
                or end is None
            ):
                continue

            start = float(start)
            end = float(end)

            assignment = assign_speaker(
                start,
                end,
                exclusive_diarization,
            )

            active = active_speakers(
                start,
                end,
                speaker_diarization,
            )

            speaker = assignment[
                "speaker"
            ]

            # Regular diarization does not back the
            # exclusive choice.
            if (
                speaker is not None
                and active
                and speaker not in active
            ):
                assignment[
                    "ambiguous"
                ] = True

            if len(active) > 1:
                assignment[
                    "ambiguous"
                ] = True

            words.append(
                {
                    "start": start,
                    "end": end,
                    "speaker": speaker,
                    "word": word[
                        "word"
                    ],
                    "overlap": (
                        len(active) > 1
                    ),
                    "active_speakers": (
                        active
                    ),
                    "speaker_assignment": (
                        assignment
                    ),
                }
            )

    return words


def new_utterance(
    word: dict,
) -> dict:
    return {
        "start": word["start"],
        "end": word["end"],
        "speaker": word["speaker"],
        "text": word["word"],
        "overlap": word["overlap"],
        "ambiguous_word_count": int(
            word[
                "speaker_assignment"
            ]["ambiguous"]
        ),
        "word_count": 1,
    }


def build_utterances(
    words: list[dict],
    max_gap: float = UTTERANCE_MAX_GAP,
) -> list[dict]:
    utterances = []

    for word in words:
        if not utterances:
            utterances.append(
                new_utterance(word)
            )
            continue

        previous = utterances[-1]

        gap = (
            word["start"]
            - previous["end"]
        )

        if (
            word["speaker"]
            == previous["speaker"]
            and gap <= max_gap
        ):
            previous["end"] = (
                word["end"]
            )

            previous["text"] += (
                word["word"]
            )

            previous["overlap"] = (
                previous["overlap"]
                or word["overlap"]
            )

            previous[
                "ambiguous_word_count"
            ] += int(
                word[
                    "speaker_assignment"
                ]["ambiguous"]
            )

            previous["word_count"] += 1

        else:
            utterances.append(
                new_utterance(word)
            )

    for utterance in utterances:
        utterance["text"] = (
            utterance["text"]
            .strip()
        )

    return utterances


def print_stats(
    words: list[dict],
    utterances: list[dict],
) -> None:
    methods = [
        word["speaker_assignment"][
            "method"
        ]
        for word in words
    ]

    rows = [
        ("words", len(words)),
        (
            "  by overlap",
            methods.count("overlap"),
        ),
        (
            "  by nearest fallback",
            methods.count("nearest"),
        ),
        (
            "  unassigned",
            methods.count("unassigned"),
        ),
        (
            "  ambiguous",
            sum(
                word[
                    "speaker_assignment"
                ]["ambiguous"]
                for word in words
            ),
        ),
        (
            "  during overlap",
            sum(
                word["overlap"]
                for word in words
            ),
        ),
        ("utterances", len(utterances)),
        (
            "  with overlap",
            sum(
                utterance["overlap"]
                for utterance in utterances
            ),
        ),
        (
            "  with ambiguous words",
            sum(
                utterance[
                    "ambiguous_word_count"
                ]
                > 0
                for utterance in utterances
            ),
        ),
    ]

    for label, count in rows:
        print(
            f"{label:<24}{count}",
            file=sys.stderr,
        )


def timestamp(
    seconds: float,
) -> str:
    milliseconds = round(
        seconds * 1000
    )

    hours, milliseconds = divmod(
        milliseconds,
        3_600_000,
    )

    minutes, milliseconds = divmod(
        milliseconds,
        60_000,
    )

    seconds, milliseconds = divmod(
        milliseconds,
        1000,
    )

    return (
        f"{hours:02}:"
        f"{minutes:02}:"
        f"{seconds:02}."
        f"{milliseconds:03}"
    )


def write_vtt(
    path: Path,
    utterances: list[dict],
) -> None:
    with path.open(
        "w",
        encoding="utf-8",
    ) as output:
        output.write(
            "WEBVTT\n\n"
        )

        for index, utterance in enumerate(
            utterances,
            start=1,
        ):
            speaker = (
                utterance["speaker"]
                or "UNKNOWN"
            )

            output.write(
                f"{index}\n"
            )

            output.write(
                f"{timestamp(utterance['start'])}"
                " --> "
                f"{timestamp(utterance['end'])}"
                "\n"
            )

            output.write(
                f"{speaker}: "
                f"{utterance['text']}"
                "\n\n"
            )


def write_txt(
    path: Path,
    utterances: list[dict],
) -> None:
    with path.open(
        "w",
        encoding="utf-8",
    ) as output:
        for utterance in utterances:
            speaker = (
                utterance["speaker"]
                or "UNKNOWN"
            )

            output.write(
                f"[{timestamp(utterance['start'])}] "
                f"{speaker}: "
                f"{utterance['text']}\n"
            )


def main() -> None:
    args = parse_args()

    hf_token = load_hf_token()

    file = resolve_input(
        args.input
    )

    print(
        "Loading speaker diarization pipeline...",
        file=sys.stderr,
    )

    # Load the gated model first so authentication
    # and access errors fail before transcription starts.
    pipeline = Pipeline.from_pretrained(
        DIARIZATION_MODEL,
        token=hf_token,
    )

    transcription = load_or_transcribe(
        file,
        args.language,
    )

    print(
        "Decoding audio with system FFmpeg...",
        file=sys.stderr,
    )

    audio = decode_audio(
        file
    )

    print(
        "Running speaker diarization...",
        file=sys.stderr,
    )

    with ProgressHook() as hook:
        diarization_output = pipeline(
            audio,
            hook=hook,
        )

    # Exclusive diarization picks one primary speaker per word;
    # regular diarization keeps simultaneous speakers.
    exclusive_diarization = turns_to_dicts(
        diarization_output
        .exclusive_speaker_diarization
    )

    speaker_diarization = turns_to_dicts(
        diarization_output
        .speaker_diarization
    )

    words = build_words(
        transcription,
        exclusive_diarization,
        speaker_diarization,
    )

    utterances = build_utterances(
        words
    )

    speakers = sorted(
        {
            utterance["speaker"]
            for utterance in utterances
            if utterance["speaker"]
            is not None
        }
    )

    result = {
        "source": str(file),
        "language": transcription[
            "language"
        ],
        "text": transcription[
            "text"
        ],
        "whisper_model": WHISPER_MODEL,
        "diarization_model": (
            DIARIZATION_MODEL
        ),
        "speakers": speakers,
        "utterances": utterances,
        "words": words,
        # Kept as exclusive diarization for existing consumers.
        "diarization": exclusive_diarization,
        "exclusive_diarization": (
            exclusive_diarization
        ),
        "speaker_diarization": (
            speaker_diarization
        ),
    }

    json_path = file.with_suffix(
        ".diarized.json"
    )

    vtt_path = file.with_suffix(
        ".diarized.vtt"
    )

    txt_path = file.with_suffix(
        ".diarized.txt"
    )

    save_json(
        json_path,
        result,
    )

    write_vtt(
        vtt_path,
        utterances,
    )

    write_txt(
        txt_path,
        utterances,
    )

    print(
        file=sys.stderr,
    )

    print(
        f"Speakers: "
        f"{len(speakers)}"
        + (
            f" ({', '.join(speakers)})"
            if speakers
            else ""
        ),
        file=sys.stderr,
    )

    print_stats(
        words,
        utterances,
    )

    print(
        f"JSON: {json_path}",
        file=sys.stderr,
    )

    print(
        f"VTT:  {vtt_path}",
        file=sys.stderr,
    )

    print(
        f"TXT:  {txt_path}",
        file=sys.stderr,
    )


if __name__ == "__main__":
    main()
