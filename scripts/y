#!/bin/bash
#
# yt-dlp with subtitles in one language. Subtitle and playlist defaults
# (--write-subs, --write-auto-subs, --sub-format vtt, --no-playlist) come
# from ~/.config/yt-dlp/config.
#
#   y [-l LANG] [-p] [yt-dlp args...] URL...
#     -l LANG  subtitle language (default: en); "none" = no subtitles
#     -p       download the whole playlist
#
# Old names are symlinks to this file and only change the defaults:
#   ylist = y -p, yp = y -l pl, yplist = y -l pl -p, ynosubs = y -l none
#
# TODO: The problem with this solution: when there is some other problem than no subs in this language,
# It will still download them.
# ERROR: Unable to download video subtitles for 'en': HTTP Error 429: Too Many Requests
#yt-dlp --sub-langs en "$1" || yt-dlp --sub-langs pl "$1" || yt-dlp --no-write-subs --no-write-auto-subs "$1"

set -euo pipefail

lang=en
playlist=false

case "$(basename "$0")" in
	ylist) playlist=true ;;
	yp) lang=pl ;;
	yplist) lang=pl playlist=true ;;
	ynosubs) lang=none ;;
esac

# Only leading -l/-p are ours; everything from the first other argument on
# goes to yt-dlp unchanged.
while [[ $# -gt 0 ]]; do
	case $1 in
		-l) lang=${2:?-l needs a language}; shift 2 ;;
		-p) playlist=true; shift ;;
		*) break ;;
	esac
done

args=()
if [[ $lang == none ]]; then
	args+=(--no-write-subs --no-write-auto-subs)
else
	args+=(--sub-format vtt --write-auto-subs --write-subs --sub-langs "$lang")
fi
if [[ $playlist == true ]]; then
	args+=(--yes-playlist)
fi

exec yt-dlp "${args[@]}" "$@"
