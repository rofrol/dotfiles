#!/bin/bash

set -euo pipefail

if [[ $# -ne 1 ]]; then
	echo "Usage: $(basename "$0") <youtube-url>" >&2
	exit 1
fi

URL="$1"

yt-dlp -J --skip-download --no-playlist "$URL" |
	jq -r '
    [
      (.subtitles // {}),
      (.automatic_captions // {})
    ]
    | add
    | to_entries[]
    | .key as $alias
    | [.value[] | select(.ext == "vtt")] as $vtts
    | select($vtts | length > 0)
    | select($vtts | all((.url | contains("tlang=")) | not))
    | $alias
  ' |
	sort -u
