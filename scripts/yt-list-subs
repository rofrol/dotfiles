#!/bin/bash

set -euo pipefail

if [[ $# -ne 1 ]]; then
	echo "Usage: $(basename "$0") <youtube-url>" >&2
	exit 1
fi

for cmd in yt-dlp jq; do
	command -v "$cmd" >/dev/null || {
		echo "Missing dependency: $cmd" >&2
		exit 127
	}
done

# List subtitle aliases that are safe to use with:
#
#   --write-subs --write-auto-subs --sub-format vtt --sub-langs <alias>
#
# Manual and automatic captions must be checked together. The same alias can
# exist in both; merging the objects with `+` would overwrite duplicate keys.
#
# An alias is rejected if any of its VTT entries is an on-demand translation
# (`tlang=...`), because yt-dlp may try that entry when the alias is selected.

out=$(
	yt-dlp -J --no-playlist --no-warnings -- "$1" |
		jq -r '
			[
				(.subtitles, .automatic_captions)
				| . // {}
				| to_entries[]
				| .key as $lang
				| .value[]?
				| select(.ext == "vtt")
				| {lang: $lang, url: .url}
			]
			| group_by(.lang)[]
			| select(
				all(
					.[];
					(.url | type) == "string"
					and (.url | length) > 0
					and (.url | test("[?&]tlang=") | not)
				)
			)
			| .[0].lang
		'
)

if [[ -z $out ]]; then
	echo "No safe VTT subtitles found" >&2
	exit 2
fi

printf '%s\n' "$out"
