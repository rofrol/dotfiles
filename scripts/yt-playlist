#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["google-auth-oauthlib", "google-api-python-client"]
# ///
"""Manage my own YouTube playlists through the official YouTube Data API (OAuth, no cookies).

  yt-playlist auth                     # one-time browser login; token in ~/.local/share/musicdb/youtube-token.json
  yt-playlist list                     # my playlists with ids and sizes
  yt-playlist use ID [ID ...]          # the music playlists musicdb deletions should clean up
  yt-playlist find VIDEO_ID            # which of those playlists contain the video
  yt-playlist remove VIDEO_ID [--dry-run]   # remove the video from those playlists

Setup (once): Google Cloud project with "YouTube Data API v3" enabled, an OAuth client of type
"Desktop app", its JSON saved as ~/.local/share/musicdb/youtube-client.json. Playlist choice is kept in
$MUSICDB_DATA/youtube-playlists.json. Quota: a list page costs 1 unit, a removal 50 (10,000 a day).
"""
import argparse, json, os, pathlib, sys

SECRETS = pathlib.Path(os.environ.get("MUSICDB_SECRETS", pathlib.Path.home() / ".local/share/musicdb"))
CLIENT, TOKEN = SECRETS / "youtube-client.json", SECRETS / "youtube-token.json"
DATA = pathlib.Path(os.environ.get("MUSICDB_DATA", pathlib.Path.home() / "personal_projects/music-data"))
CHOSEN = DATA / "youtube-playlists.json"
SCOPES = ["https://www.googleapis.com/auth/youtube"]  # read + edit my playlists


def creds(interactive=False):
    from google.auth.transport.requests import Request
    from google.oauth2.credentials import Credentials
    c = Credentials.from_authorized_user_file(str(TOKEN), SCOPES) if TOKEN.exists() else None
    if c and c.expired and c.refresh_token:
        c.refresh(Request())
    elif not (c and c.valid):
        if not interactive:
            sys.exit("not logged in to YouTube: run `yt-playlist auth`")
        if not CLIENT.exists():
            sys.exit(f"missing OAuth client JSON: {CLIENT} (see `yt-playlist --help`)")
        from google_auth_oauthlib.flow import InstalledAppFlow
        c = InstalledAppFlow.from_client_secrets_file(str(CLIENT), SCOPES).run_local_server(port=0)
    SECRETS.mkdir(parents=True, exist_ok=True)
    TOKEN.write_text(c.to_json())
    TOKEN.chmod(0o600)
    return c


def api(interactive=False):
    from googleapiclient.discovery import build
    return build("youtube", "v3", credentials=creds(interactive), cache_discovery=False)


def pages(request_fn, **kw):
    token = None
    while True:
        r = request_fn(pageToken=token, maxResults=50, **kw).execute()
        yield from r.get("items", [])
        token = r.get("nextPageToken")
        if not token:
            return


def chosen():
    return json.loads(CHOSEN.read_text()) if CHOSEN.exists() else []


def items_with(yt, video_id):
    """[(playlist id, playlist item id)] of the chosen playlists that contain the video."""
    out = []
    for pid in chosen():
        for it in pages(yt.playlistItems().list, part="id,snippet", playlistId=pid, videoId=video_id):
            out.append((pid, it["id"]))
    return out


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(dest="cmd", required=True)
    sp.add_parser("auth")
    sp.add_parser("list")
    p = sp.add_parser("use"); p.add_argument("ids", nargs="+")
    p = sp.add_parser("find"); p.add_argument("video")
    p = sp.add_parser("remove"); p.add_argument("video"); p.add_argument("--dry-run", action="store_true")
    a = ap.parse_args()
    if a.cmd == "auth":
        api(interactive=True)
        print(f"logged in; token in {TOKEN}")
    elif a.cmd == "list":
        mine = set(chosen())
        for pl in pages(api().playlists().list, part="snippet,contentDetails", mine=True):
            print(f"{'*' if pl['id'] in mine else ' '} {pl['id']}  {pl['contentDetails']['itemCount']:4d}  {pl['snippet']['title']}")
    elif a.cmd == "use":
        CHOSEN.parent.mkdir(parents=True, exist_ok=True)
        CHOSEN.write_text(json.dumps(a.ids, indent=1) + "\n")
        print(f"{len(a.ids)} playlists saved to {CHOSEN}")
    elif a.cmd == "find":
        for pid, item in items_with(api(), a.video):
            print(pid, item)
    elif a.cmd == "remove":
        yt = api()
        hits = items_with(yt, a.video)
        for pid, item in hits:
            if not a.dry_run:
                yt.playlistItems().delete(id=item).execute()
            print(f"{'would remove' if a.dry_run else 'removed'} {a.video} from {pid}")
        print(json.dumps({"video": a.video, "removed": [] if a.dry_run else [p for p, _ in hits]}))


if __name__ == "__main__":
    main()
