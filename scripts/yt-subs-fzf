#!/bin/bash

set -euo pipefail

if [[ $# -ne 1 ]]; then
	echo "Usage: $(basename "$0") <youtube-url>" >&2
	exit 1
fi

for cmd in yt-dlp jq fzf; do
	command -v "$cmd" >/dev/null || {
		echo "Missing dependency: $cmd" >&2
		exit 127
	}
done

URL="$1"

# Fetch metadata once: subtitles are validated and downloaded from the same
# snapshot, so the safety check below still holds at download time.
INFO=$(mktemp)
trap 'rm -f "$INFO"' EXIT
yt-dlp -J --no-playlist --no-warnings -- "$URL" >"$INFO"

# Mirror yt-dlp's subtitle selection (YoutubeDL.process_subtitles) for:
#
#   --write-subs --write-auto-subs --sub-format vtt --sub-langs <alias>
#
# - Manual subtitles take precedence over automatic captions with the same
#   alias; in jq object addition the right-hand side wins, so auto + manual
#   reproduces that.
# - For each alias yt-dlp downloads only the last VTT entry, so only that
#   entry is checked. It is rejected when it is an on-demand translation
#   (`tlang=...`), which YouTube often rate-limits (HTTP 429).
SUBS=$(
	jq -r '
		((.automatic_captions // {}) + (.subtitles // {}))
		| to_entries[]
		| .key as $lang
		| [.value[]? | select(.ext == "vtt")] as $vtts
		| select($vtts | length > 0)
		| $vtts[-1].url
		| select(type == "string" and length > 0 and (test("[?&]tlang=") | not))
		| $lang
	' "$INFO"
)

if [[ -z $SUBS ]]; then
	echo "No safe VTT subtitles found" >&2
	exit 2
fi

# fzf exits 130 on cancel; propagate it instead of reporting success.
SELECTED=$(printf '%s\n' "$SUBS" | fzf --multi --prompt='Subtitles: ')

# --sub-langs takes regexes (applied with fullmatch); escape aliases so they
# match literally.
LANGS=$(printf '%s\n' "$SELECTED" | sed 's/[][\.*^$+?(){}|]/\\&/g' | paste -sd, -)

yt-dlp \
	--load-info-json "$INFO" \
	--skip-download \
	--write-subs \
	--write-auto-subs \
	--sub-format vtt \
	--sub-langs "$LANGS"
